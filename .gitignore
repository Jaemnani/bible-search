# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# large data files
/datas/
/public/data/*.bin  # 만약 50MB가 넘으면 제외해야 할 수도 있음
!/public/data/*.json
!/public/data/*.bin
# 단락 사전생성 체크포인트 (런타임 산출물 — commit 제외)
/public/data/passage_progress.json
# 초성 인덱스(파생물 4MB+ — 런타임 chosung.ts로 계산, scripts/build_indexes.py로 재생성)
/public/data/verse_chosung.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python venv (numpy for data pipeline)
.venv/
__pycache__/

# float32 임베딩 사이드카 (양자화 재실험용, 배포 제외)
embeddings_src/

# backend self-host 런타임 볼륨(DB/스토리지/캐디 데이터)
/backend/volumes/

# 크롤러 런타임 로그
/crawler/data/
