# 구절 미디어 크롤러 — 환경변수 (cp .env.example .env)
# run.sh 가 .env 를 자체 로드하므로 cron 은 수정 불필요(키만 추가).

# NAS 백엔드 (verse_media 적재 — RLS 우회 service key)
SUPABASE_URL=http://<NAS_IP>:8081
SUPABASE_SERVICE_KEY=

# MinIO — 현재 크롤러는 쓰지 않는다(썸네일은 공식 URL 핫링크, 재호스팅 금지).
MINIO_ENDPOINT=http://<NAS_IP>:9100
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_PUBLIC_URL=https://<DOMAIN>/storage

# 수집 소스
YOUTUBE_API_KEY=          # YouTube Data API v3 (무료 쿼터 10,000 unit/일). 없으면 영상 수집만 건너뜀
# 책은 Google Books API — 키 불필요(익명 쿼터. 429 나면 다음 실행에서 이어서 진행)

# 알림 (docs 05) — 미설정 시 no-op
DISCORD_WEBHOOK_URL=
