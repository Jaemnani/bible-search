# Caddy — supabase-js 호환 경로 라우팅 (Supabase Kong 대체)
#   /rest/v1/*  → PostgREST   (supabase-js 가 ${SUPABASE_URL}/rest/v1/<table> 호출)
#   /storage/*  → MinIO        (낙서·오디오·썸네일 공개 GET — {bucket}/{key})
# TLS 는 외부 역방향 프록시/Cloudflare Tunnel 이 종단 → Caddy 는 평문 :80.

:80 {
	# supabase-js 인증 호출 → GoTrue
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/* {
		reverse_proxy storage:9000
	}
	# handle 블록은 작성 순서대로 평가 — /health 를 catch-all 보다 먼저.
	handle /health {
		respond "ok" 200
	}
	handle {
		respond "bible backend — use /auth/v1/* or /rest/v1/* or /storage/*" 404
	}
}
