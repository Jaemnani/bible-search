# bible-reader self-hosted backend — 환경변수 템플릿
# cp .env.example .env  후 값 채우기.  비밀번호:  openssl rand -base64 24   (JWT_SECRET 은 -base64 48)

# --- Postgres ---
POSTGRES_PASSWORD=

# --- PostgREST authenticator 역할 (bootstrap/00_roles.sql 의 CHANGE_ME_SAME_AS_ENV 와 동일) ---
AUTHENTICATOR_PASSWORD=

# --- JWT (anon/service 키 발급 + PostgREST 검증 + auth.uid() 의 sub 클레임 공용) ---
# 인증 제공자(예: self-host GoTrue)도 이 JWT_SECRET 으로 HS256 서명하도록 맞추면 auth.uid() 동작.
JWT_SECRET=

# --- MinIO (낙서/오디오/썸네일) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- 인증 (GoTrue) ---
# 외부에서 접근할 인증/백엔드 공개 URL(필수). 노출 후엔 그 주소로:
#   예) https://jeremylab.synology.me:8443   (미설정 시 http://localhost:8081 로 기동만 됨)
API_EXTERNAL_URL=
SITE_URL=http://localhost:3000     # 로그인 리다이렉트 기준(웹/앱 콜백 도메인)
# 외부 OAuth — iOS 공개앱은 Apple 필수. 설정 시 ENABLED=true + 키 채우기.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_SECRET=

# --- pgAdmin (profile=admin 일 때만) ---
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=
